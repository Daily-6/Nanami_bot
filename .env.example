# ===================== API 密钥（必填，替换为真实值） =====================
DEEPSEEK_API_KEY=your_deepseek_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ===================== NoneBot 运行配置 =====================
DRIVER=~fastapi
LOCALSTORE_CACHE_DIR='C:\Users\<用户名>\AppData\Local\nonebot2-nanami_bot\Cache'
LOCALSTORE_DATA_DIR='C:\Users\<用户名>\AppData\Local\nonebot2-nanami_bot'
LOCALSTORE_CONFIG_DIR='C:\Users\<用户名>\AppData\Roaming\nonebot2-nanami_bot'

HOST=127.0.0.1
PORT=8080
SUPERUSERS=["你的QQ号"]
NICKNAME=["Nanami bot"]
COMMAND_START=[""]

# ===================== aitalk 插件配置（按需） =====================
render_backend=playwright
aitalk_completion_config = '{"max_token": 1024, "temperature": 0.9, "top_p": 0.9}'
aitalk_api_list = '
[
  {
    "name": "deepseek",
    "api_key": "your_deepseek_api_key_here",
    "model_name": "deepseek-v4-flash",
    "api_url": "https://api.deepseek.com",
    "image_input": false,
    "send_thinking": false,
    "description": "DeepSeek v4模型"
  },
  {
    "name": "qwen",
    "api_key": "your_qwen_api_key_here",
    "model_name": "Qwen2.5-VL-32B-Instruct",
    "api_url": "https://njusehub.info/v1",
    "image_input": true,
    "send_thinking": false,
    "description": "qwen72b 模型"
  }
]
'
aitalk_available_memes = '
[
  { "url": "./data/memes/0.png", "desc": "满意 高兴" }
]
'
aitalk_default_model="qwen"
aitalk_default_prompt_file="./prompt.txt"
aitalk_tts_enabled=false
aitalk_active_reply_enabled=false
aitalk_active_reply_probability=0.8
aitalk_reply=true
aitalk_command_start=""
